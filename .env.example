# Optional override: copy this file to .env.local and replace the placeholder with your own
# Web3Forms access key linked to ukaninirmik65@gmail.com.
# Web3Forms access keys are public form identifiers, not private API secrets.
VITE_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Optional Google Analytics 4 web data-stream Measurement ID, for example G-XXXXXXXXXX.
# This is public client-side configuration, not a secret. GA4 stays disabled until set.
VITE_GA4_MEASUREMENT_ID=YOUR_GA4_MEASUREMENT_ID
